# host interface for the router
HOST_IP=192.168.1.109

# memory limits: servers hold PHOEBE + passband tables in RAM; router is tiny.
SERVER_MEMORY_LIMIT=172g
ROUTER_MEMORY_LIMIT=256m

# PHOEBE 2.4:
SERVER24_GIT_REMOTE=phoebe-project  # where to pull phoebe from
SERVER24_BRANCH=2.4.22              # git tag/branch baked into the image
SERVER24_VERSION=2.4                # image tag + container name + routing key
SERVER24_DATA=./data/2.4            # passband data mounted read-only at /tables/data

# PHOEBE 2.5:
SERVER25_GIT_REMOTE=phoebe-project
SERVER25_BRANCH=feature-blending  # change 2.5 when released
SERVER25_VERSION=2.5
SERVER25_DATA=./data/2.5

# router:
ROUTER_VERSION=1.0
ROUTER_PORT=8084
